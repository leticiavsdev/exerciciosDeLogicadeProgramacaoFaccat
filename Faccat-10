Algoritmo "Faccat-10"
// Disciplina   : [Lógica de Programação em JS]
// Professor   :Jailson
// Descrição   :10) O custo de um carro novo ao consumidor é a soma do custo
//de fábrica com a porcentagem do distribuidor e dos impostos (aplicados ao
//custo de fábrica). Supondo que o percentual do distribuidor seja de 28% e
//os impostos de 45%, escrever um algoritmo para ler o custo de fábrica de
//um carro, calcular e escrever o custo final ao consumidor.
// Aluno : Leticia Vitoria
// Data atual  : 26/09/2026
Var
   // Seção de Declarações das variáveis
   custoFabrica, custoFinal: real
Inicio
   // Seção de Comandos, procedimento, funções, operadores, etc...
   Escreval("Digite o custo de fábrica do carro: ")
   leia(custoFabrica)
   custoFinal <- custoFabrica + (custoFabrica * 28 / 100) + (custoFabrica * 45 / 100)
   limpatela
   Escreval("O custo final do carro é: R$ ", custoFinal)


Fimalgoritmo
