Algoritmo "Faccat-32"
// Disciplina   : [Lógica de Programação em JS]
// Professor    : Jailson
// Descrição    :32) Ler o nome de 2 times e o número de gols marcados na
//partida (para cada time). Escrever o nome do vencedor. Caso não haja
//vencedor deverá ser impressa a palavra EMPATE.
//dos outros 2 lados.

// Aluno        : Leticia Vitoria
// Data atual   : 26/09/2026

Var
   // Seção de Declarações das variáveis
   time1, time2 : caractere
   gols1, gols2 : inteiro

Inicio
   // Seção de Comandos, procedimento, funções, operadores, etc...
   Escreval("Digite o nome do primeiro time: ")
   leia(time1)

   Escreval("Digite o número de gols do ", time1, ": ")
   leia(gols1)

   Escreval("Digite o nome do segundo time: ")
   leia(time2)

   Escreval("Digite o número de gols do ", time2, ": ")
   leia(gols2)

   se gols1 > gols2 entao
      Escreval("Vencedor: ", time1)
   senao
      se gols2 > gols1 entao
         Escreval("Vencedor: ", time2)
      senao
         Escreval("EMPATE")
      fimse
   fimse

Fimalgoritmo
