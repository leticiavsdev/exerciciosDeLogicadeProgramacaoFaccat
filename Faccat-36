Algoritmo "Faccat-36"
// Disciplina   : [Lógica de Programação em JS]
// Professor    : Jailson
// Descrição    : 36) Escreva um algoritmo que leia as idades de 2 homens e de 2 mulheres (considere que as idades
//dos homens serão sempre diferentes entre si, bem como as das mulheres). Calcule e escreva a soma
//das idades do homem mais velho com a mulher mais nova, e o produto das idades do homem mais
//novo com a mulher mais velha.
// Aluno        : Leticia Vitoria
// Data atual   : 26/09/2026

Var
   // Seção de Declarações das variáveis
   homem1, homem2, mulher1, mulher2: inteiro
   homemVelho, homemNovo: inteiro
   mulherVelha, mulherNova: inteiro
   soma, produto: inteiro
Inicio
   // Seção de Comandos, procedimento, funções, operadores, etc...
   escreva("Digite a idade do primeiro homem: ")
   leia(homem1)
   escreva("Digite a idade do segundo homem: ")
   leia(homem2)
   escreva("Digite a idade da primeira mulher: ")
   leia(mulher1)
   escreva("Digite a idade da segunda mulher: ")
   leia(mulher2)

   se homem1 > homem2 entao
      homemVelho <- homem1
      homemNovo <- homem2
   senao
      homemVelho <- homem2
      homemNovo <- homem1
   fimse

   se mulher1 > mulher2 entao
      mulherVelha <- mulher1
      mulherNova <- mulher2
   senao
      mulherVelha <- mulher2
      mulherNova <- mulher1
   fimse

   soma <- homemVelho + mulherNova
   produto <- homemNovo * mulherVelha

   escreval("Soma do homem mais velho com a mulher mais nova: ", soma)
   escreval("Produto do homem mais novo com a mulher mais velha: ", produto)
   
Fimalgoritmo
