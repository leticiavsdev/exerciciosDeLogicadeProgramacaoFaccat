Algoritmo "Faccat-24"
// Disciplina   : [Lógica de Programação em JS]
// Professor    : Jailson
// Descrição    : 24) Ler o salário fixo e o valor das vendas efetuadas pelo
// vendedor de uma empresa. Sabendo-se que ele recebe uma comissão de 3% sobre
// o total das vendas até R$ 1.500,00 mais 5% sobre o que
// ultrapassar este valor, calcular e escrever o seu salário total.

// Aluno        : Leticia Vitoria
// Data atual   : 26/09/2026

Var
   // Seção de Declarações das variáveis
   salario, vendas, comissao : real

Inicio
   // Seção de Comandos, procedimento, funções, operadores, etc...
   Escreval("Digite o seu salário fixo: ")
   leia(salario)

   Escreval("Digite o valor das vendas: ")
   leia(vendas)

   se vendas <= 1500 entao
      comissao <- vendas * 3 / 100
   senao
      comissao <- (1500 * 3 / 100) + ((vendas - 1500) * 5 / 100)
   fimse

   Escreval("O seu salário será: R$ ", salario + comissao)

Fimalgoritmo
